# =========================================
# Remember Me — Root .gitignore
# =========================================

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================================
# Node / Frontend (Svelte + Vite)
# =========================================
node_modules/
dist/
.svelte-kit/
build/
*.local

# Vite cache
.vite/

# Tauri
src-tauri/target/
src-tauri/gen/

# =========================================
# Go / Backend
# =========================================
backend/bin/
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib
backend/coverage.out
backend/coverage.html

# Test binary
backend/*.test
backend/.test/

# =========================================
# Environment variables
# =========================================
.env
.env.local
.env.*.local
backend/.env

# Allow .env.example to be committed
!.env.example
!backend/.env.example

# =========================================
# Database
# =========================================
*.sql.bak
*.dump

# =========================================
# Misc
# =========================================
*.tmp
*.bak
.cache/
.tmp/
