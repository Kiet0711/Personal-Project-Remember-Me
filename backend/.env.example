# Remember Me Backend — Environment Variables (EXAMPLE)
# Copy to .env and fill in real values. NEVER commit .env.

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Server
SERVER_PORT=8080

# Database (PostgreSQL — local, no Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=remember_me
DB_USER=postgres
DB_PASSWORD=

# JWT (required)
JWT_SECRET=
JWT_EXPIRES_IN=7200

# Session
SESSION_LIFETIME=7200
